* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #ffffff;
  font-family: 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  color: #1e293b;
  line-height: 1.6;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  min-height: 100vh;
  padding: 2rem 1rem;
}

.container {
  width: 100%;
  max-width: 760px;
}

h1 {
  font-size: 2rem;
  font-weight: 450;
  color: #0f172a;
  border-left: 4px solid #3b82f6;
  padding-left: 1rem;
  margin-bottom: 1.8rem;
}

.phase-title {
  color: #64748b;
  font-size: 0.9rem;
  margin-bottom: 2rem;
  border-bottom: 1px solid #e2e8f0;
  padding-bottom: 0.8rem;
}

.quiz-block {
  margin-bottom: 2rem;
}

.question-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 1.2rem;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  transition: border 0.15s;
}

.question-card:hover {
  border-color: #3b82f6;
}

.question-header {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  margin-bottom: 1rem;
  color: #0f172a;
  font-weight: 500;
  font-size: 0.95rem;
  flex-wrap: wrap;
}

.q-id {
  color: #3b82f6;
  font-weight: 600;
  font-size: 0.85rem;
  white-space: nowrap;
}

.q-text {
  line-height: 1.5;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 0.8rem;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  padding: 0.5rem 0.8rem;
  border-radius: 0.8rem;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  cursor: pointer;
  transition: all 0.15s;
}

.option-item:hover {
  background: #f8fafc;
  border-color: #3b82f6;
}

.option-item.selected {
  background: #eff6ff;
  border-color: #2563eb;
}

.option-letter {
  font-weight: 600;
  color: #3b82f6;
  min-width: 1.6rem;
  font-size: 0.9rem;
}

.option-text {
  color: #334155;
  font-size: 0.9rem;
  line-height: 1.5;
}

.nav-buttons {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin: 1.5rem 0 2rem;
}

button {
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  padding: 0.7rem 1.5rem;
  border-radius: 2rem;
  font-weight: 500;
  color: #1e293b;
  cursor: pointer;
  font-size: 0.9rem;
  transition: all 0.2s;
}

button:hover {
  background: #e2e8f0;
}

button.primary {
  background: #3b82f6;
  border-color: #3b82f6;
  color: white;
}

button.primary:hover {
  background: #2563eb;
}

.report-container {
  margin-top: 2rem;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 1.5rem;
  padding: 2rem 1.5rem;
  line-height: 1.7;
}

.report-section h2 {
  font-weight: 500;
  font-size: 1.25rem;
  margin: 2rem 0 1rem;
  color: #0f172a;
  border-left: 4px solid #3b82f6;
  padding-left: 0.8rem;
}

.report-section h3 {
  font-weight: 500;
  font-size: 1rem;
  margin: 1.5rem 0 0.5rem;
  color: #1e293b;
}

.garden-text {
  margin-bottom: 1.5rem;
  padding-left: 1rem;
  border-left: 2px solid #e2e8f0;
}

.table-wrap {
  overflow-x: auto;
  margin: 1rem 0;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

th, td {
  border: 1px solid #e2e8f0;
  padding: 0.5rem 0.8rem;
  text-align: left;
}

th {
  background: #f8fafc;
  font-weight: 500;
}

hr {
  border: none;
  border-top: 1px solid #e2e8f0;
  margin: 2rem 0;
}

.small-note {
  color: #94a3b8;
  font-size: 0.8rem;
  margin-top: 1.5rem;
}

.hidden {
  display: none;
}

.spacer {
  height: 1rem;
}
















